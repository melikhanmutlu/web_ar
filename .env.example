# ARVision environment variables.
# Copy to .env for local development (never commit .env). On Railway set these
# in the service Variables tab instead; do not paste this whole file there.
# tests/test_env_example.py fails when the code reads a variable not listed here
# (commented-out "# NAME=value" lines count as documented).

# =============================================================================
# REQUIRED
# =============================================================================

# Signs session cookies and CSRF tokens. The app refuses to boot in production
# without it (production = FLASK_ENV=production, RAILWAY_ENVIRONMENT or DATABASE_URL set).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Legacy alias for SECRET_KEY (used only when SECRET_KEY is empty).
# WEB_AR_SECRET_KEY=

# =============================================================================
# PRODUCTION (set these on the deployed service)
# =============================================================================

# PostgreSQL connection string; Railway injects it when the Postgres plugin is
# linked. Unset = local SQLite. NOTE: setting it also switches the app into
# "production" mode (Secure cookies, SECRET_KEY required).
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated emails promoted to admin on every boot (no built-in default).
ADMIN_EMAILS=

# Canonical public URL, no trailing slash (canonical links, sitemap, OG tags, emails).
SITE_URL=https://webar.up.railway.app

# Route uploads to the separate worker.py process (the start command runs it in
# the same container). false = convert inline in request threads.
# JOB_QUEUE=true

# Bearer token for GET /metrics. Required for /metrics when FLASK_ENV=production.
METRICS_TOKEN=

# Trusted reverse-proxy hops for X-Forwarded-For (default 1; 0 = no proxy).
# PROXY_FIX_X_FOR=1
# CSP frame-ancestors for /embed/<id> without a per-model allowlist (default *).
# EMBED_DEFAULT_FRAME_ANCESTORS=*
# One counted /view per visitor per model per N seconds (default 1800).
# VIEW_DEDUPE_SECONDS=1800

# Error tracking. No-op when SENTRY_DSN is empty. The release is taken from
# RAILWAY_GIT_COMMIT_SHA / SOURCE_COMMIT automatically.
SENTRY_DSN=
# Defaults to RAILWAY_ENVIRONMENT_NAME, then FLASK_ENV.
# SENTRY_ENVIRONMENT=production
# Performance tracing sample rate, 0.0-1.0 (0 = off).
# SENTRY_TRACES_SAMPLE_RATE=0

# "json" emits one JSON object per log line (recommended on Railway); default "text".
LOG_FORMAT=json

# Storage. On Railway attach ONE volume to the service; Railway sets
# RAILWAY_VOLUME_MOUNT_PATH and uploads/, converted/, temp/, qr_codes/ are created under it.
# Platform-provided, do NOT set by hand (listed so you know the code reads them):
# RAILWAY_VOLUME_MOUNT_PATH=
# RAILWAY_ENVIRONMENT=
# RAILWAY_ENVIRONMENT_NAME=
# RAILWAY_GIT_COMMIT_SHA=
# SOURCE_COMMIT=
# PORT=
# Override the storage root explicitly (wins over RAILWAY_VOLUME_MOUNT_PATH); local use only.
# STORAGE_ROOT=/absolute/path
# !! WARNING: do NOT set the per-directory overrides below on Railway. They take
# !! precedence over the volume mount, so relative values (uploads, converted, ...)
# !! write to the container's ephemeral disk and ALL models are lost on redeploy.
# WEB_AR_BASE_DIR=
# WEB_AR_UPLOAD_DIR=
# WEB_AR_CONVERTED_DIR=
# WEB_AR_TEMP_DIR=
# WEB_AR_QR_DIR=
# Directory with bundled tools (FBX2glTF); lives in the image, not the volume.
# WEB_AR_TOOLS_DIR=

# Shared rate-limit backend; required for correct limits with more than one process.
# Default memory:// (per process).
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# Set to "false" to disable rate limiting entirely (tests/dev only).
# RATELIMIT_ENABLED=true

# =============================================================================
# OPTIONAL
# =============================================================================

# --- Flask / local development ---
# FLASK_ENV=production only on real deployments: it forces Secure cookies and a
# /metrics token, which breaks plain-HTTP local development. Leave unset locally.
# FLASK_ENV=
# Set to "True" (exact case) for Flask debug mode. Never in production.
# DEBUG=False
# Skip create_all/stamp on boot (used by the start command around `flask db upgrade`).
# SKIP_DB_BOOTSTRAP=
# Timezone offset in hours (from UTC) used when rendering admin/report timestamps.
# DISPLAY_TZ_OFFSET_HOURS=3

# --- Upload limits ---
# Max request body in bytes (default 104857600 = 100 MB).
# WEB_AR_MAX_CONTENT_LENGTH=104857600
# Max files per batch upload.
# BATCH_UPLOAD_MAX_FILES=10
# Max entries accepted inside an uploaded ZIP.
# ZIP_MAX_ENTRIES=500
# Max chunks in a chunked upload.
# CHUNK_UPLOAD_MAX_CHUNKS=10000
# Seconds without progress before a stalled upload is abandoned.
# UPLOAD_STALL_SECONDS=360
# Concurrent job-progress streams (SSE) allowed per process.
# MAX_CONCURRENT_JOB_STREAMS=4
# Max lifetime of one job-progress stream, in seconds.
# JOB_STREAM_MAX_SECONDS=600

# --- Storage quotas and retention ---
# Default per-user storage quota in MB (admins can override in site settings).
# STORAGE_QUOTA_MB=1024
# Days a deleted model stays in the trash before it is purged.
# TRASH_RETENTION_DAYS=30
# Per-plan overrides (MB of storage / AI generations per month).
# PLAN_PRO_STORAGE_QUOTA_MB=10240
# PLAN_PRO_AI_MONTHLY_LIMIT=20
# PLAN_BUSINESS_STORAGE_QUOTA_MB=102400
# PLAN_BUSINESS_AI_MONTHLY_LIMIT=200

# --- Conversion and model limits ---
# Default max model dimension (cm) used for AR scaling.
# DEFAULT_MAX_DIMENSION_CM=50
# Reject models larger than this many meters in any dimension.
# MAX_MODEL_DIMENSION_METERS=100
# Warn in the viewer when the real-world size is outside this range (meters).
# AR_SCALE_WARNING_MIN_METERS=0.02
# AR_SCALE_WARNING_MAX_METERS=20
# Reject STL/OBJ meshes above these limits.
# MAX_MESH_FACES=2000000
# MAX_MESH_VERTICES=2000000
# Max vertices for version snapshots / edits.
# MAX_MODEL_VERTICES=5000000
# Max texture size (bytes) and pixel count accepted when editing GLB textures.
# MAX_TEXTURE_BYTES=33554432
# MAX_IMAGE_PIXELS=50000000
# Face budget for server-side thumbnail rendering.
# MAX_THUMBNAIL_FACES=500000
# Heavier models are rendered from a decimated copy with about this many faces.
# THUMBNAIL_DECIMATED_FACES=200000
# Asset quality warnings: triangle count and file size (bytes).
# GLB_WARNING_TRIANGLES=250000
# GLB_WARNING_BYTES=26214400
# Fail-safe GLB compression with gltfpack. Off by default.
# GLB_OPTIMIZE=false
# STEP conversion timeout in seconds.
# STEP_CONVERT_TIMEOUT=180
# FBX probe subprocess memory cap (MB, 0 = unlimited) and timeout (seconds).
# FBX_PROBE_MEM_MB=0
# FBX_PROBE_TIMEOUT=90

# --- Worker / job queue ---
# Retry backoff for failed conversion jobs (seconds).
# JOB_RETRY_BASE_SECONDS=15
# JOB_RETRY_MAX_SECONDS=900
# Poll interval (seconds) of worker.py.
# WORKER_POLL_INTERVAL=2
# Minutes without a heartbeat before a processing job is requeued.
# WORKER_STALE_MINUTES=30
# Seconds before a worker heartbeat counts as dead in /healthz and the admin panel.
# WORKER_HEALTH_MAX_AGE_SECONDS=90
# WORKER_HEARTBEAT_STALE_SECONDS=120
# Minutes before an inline (non-queue) job is considered stale.
# INLINE_STALE_JOB_MINUTES=10
# Identifier recorded in worker heartbeats (default hostname:pid).
# WORKER_ID=
# AI job reconciliation: sweep interval, orphan grace and stale threshold (minutes).
# AI_RECONCILE_MINUTES=5
# AI_ORPHAN_STAGE_GRACE_MINUTES=20
# AI_STALE_MINUTES=30

# --- AI 3D generation (Meshy), server-side only ---
MESHY_API_KEY=
# MESHY_API_BASE=https://api.meshy.ai/openapi
# MESHY_AI_MODEL=meshy-6
# Image generation model for the optional pre-processing step.
# MESHY_IMAGE_MODEL=nano-banana-pro
# Fallback monthly AI generation limit for plans without their own allowance. 0 = off.
# AI_GEN_MONTHLY_LIMIT=0
# Credits granted by the referral program.
# REFERRAL_REFERRER_CREDITS=5
# REFERRAL_INVITEE_CREDITS=3
# REFERRAL_MONTHLY_CAP=20

# --- Email (SMTP). Leave SMTP_HOST empty to disable all email. ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=noreply@arvision.local
# EMAIL_NOTIFICATIONS_ENABLED=true

# --- Billing ---
# "paytr" or "lemonsqueezy". Leave the provider's keys empty to disable online checkout.
# PAYMENT_PROVIDER=paytr
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# 1 = PayTR test mode, 0 = live.
# PAYTR_TEST_MODE=1
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_SIGNING_SECRET=
# JSON map of plans/credit packs to Lemon Squeezy variant ids.
# LEMONSQUEEZY_VARIANTS={}
# E-invoicing: "parasut" or empty (off).
# INVOICING_PROVIDER=
# PARASUT_CLIENT_ID=
# PARASUT_CLIENT_SECRET=
# PARASUT_USERNAME=
# PARASUT_PASSWORD=
# PARASUT_COMPANY_ID=

# --- Legal pages & contact ---
# Operator details shown on /privacy and /terms; replace the bracketed
# placeholder defaults before launch. SALES_EMAIL: address for sales enquiries.
# LEGAL_ENTITY_NAME=
# LEGAL_ADDRESS=
# LEGAL_CONTACT_EMAIL=
# SALES_EMAIL=

# --- SEO ---
# Google Search Console HTML-tag verification value (only the content="" part).
# GOOGLE_SITE_VERIFICATION=
# Whether /view/<id> model pages are indexable by search engines.
# SEO_INDEX_MODEL_PAGES=false

# --- Scripts ---
# Data directory used by scripts/competitor_watch.py (default: repo root).
# WEB_AR_DATA_DIR=
