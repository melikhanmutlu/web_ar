# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=production
DEBUG=False

# Database (Railway will provide DATABASE_URL automatically)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Storage and upload configuration
WEB_AR_MAX_CONTENT_LENGTH=104857600
WEB_AR_UPLOAD_DIR=uploads
WEB_AR_CONVERTED_DIR=converted
WEB_AR_TEMP_DIR=temp
WEB_AR_QR_DIR=qr_codes
BATCH_UPLOAD_MAX_FILES=10
ZIP_MAX_ENTRIES=500

# Conversion Settings
DEFAULT_MAX_DIMENSION=0.5
DEFAULT_COLOR=#4CAF50

# External Tools
FBX2GLTF_PATH=tools/FBX2glTF.exe
OBJ2GLTF_COMMAND=npx obj2gltf

# AI 3D generation (Meshy) — server-side only
MESHY_API_KEY=
MESHY_API_BASE=https://api.meshy.ai/openapi
MESHY_AI_MODEL=meshy-5
AI_GEN_DAILY_LIMIT=10

# Optional: enable fail-safe GLB compression (gltfpack). Off by default.
GLB_OPTIMIZE=false

# Durable conversion worker and retries
JOB_QUEUE=true
JOB_RETRY_BASE_SECONDS=15
JOB_RETRY_MAX_SECONDS=900
WORKER_STALE_MINUTES=30
WORKER_HEALTH_MAX_AGE_SECONDS=90

# Production metrics endpoint (Authorization: Bearer <token>)
METRICS_TOKEN=

# Optional shared rate-limit backend for multi-instance deployments
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
