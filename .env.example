# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
FLASK_ENV=production
DEBUG=False

# Database (Railway will provide DATABASE_URL automatically)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Storage and upload configuration
WEB_AR_MAX_CONTENT_LENGTH=104857600
WEB_AR_UPLOAD_DIR=uploads
WEB_AR_CONVERTED_DIR=converted
WEB_AR_TEMP_DIR=temp
WEB_AR_QR_DIR=qr_codes
BATCH_UPLOAD_MAX_FILES=10
ZIP_MAX_ENTRIES=500

# Conversion Settings
DEFAULT_MAX_DIMENSION=0.5
DEFAULT_COLOR=#4CAF50

# External Tools
FBX2GLTF_PATH=tools/FBX2glTF.exe
OBJ2GLTF_COMMAND=npx obj2gltf

# AI 3D generation (Meshy) — server-side only
MESHY_API_KEY=
MESHY_API_BASE=https://api.meshy.ai/openapi
MESHY_AI_MODEL=meshy-5
# Image generation model for the optional pre-processing step
MESHY_IMAGE_MODEL=nano-banana-pro
# Fallback monthly AI generation quota (rolling 30-day) for users whose plan
# doesn't set its own allowance (e.g. Free). 0 = off. Paid plans override this.
AI_GEN_MONTHLY_LIMIT=0

# Optional: enable fail-safe GLB compression (gltfpack). Off by default.
GLB_OPTIMIZE=false

# Durable conversion worker and retries
JOB_QUEUE=true
JOB_RETRY_BASE_SECONDS=15
JOB_RETRY_MAX_SECONDS=900
WORKER_STALE_MINUTES=30
WORKER_HEALTH_MAX_AGE_SECONDS=90

# Production metrics endpoint (Authorization: Bearer <token>)
METRICS_TOKEN=

# Optional shared rate-limit backend for multi-instance deployments
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# SEO: canonical production URL (no trailing slash). Used for canonical
# links, sitemap.xml <loc> entries, robots.txt's Sitemap: line, and
# absolute OG/Twitter URLs. Update if a custom domain replaces the Railway
# subdomain.
SITE_URL=https://webar.up.railway.app

# SEO: Google Search Console HTML-tag verification value (Search Console >
# Settings > Ownership verification > HTML tag > copy just the content=""
# value, not the whole <meta> tag). Leave empty until you create the property.
GOOGLE_SITE_VERIFICATION=

# SEO: whether /view/<id> model pages are indexable by search engines.
# Off by default (models have no public/private distinction yet).
SEO_INDEX_MODEL_PAGES=false

# Billing / payments (PayTR iFrame API). Leave unset to disable online checkout.
PAYMENT_PROVIDER=paytr
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
BILLING_CURRENCY=TRY
